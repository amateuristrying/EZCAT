# EZCAT Application Environment Variables Template
# Copy this file to .env and replace placeholder values with actual keys.
# DO NOT commit .env to version control.

# AI Coaching & Question Recommendation API Key
EXPO_PUBLIC_AI_API_KEY=your_llm_api_key_here

# API Base URL (if connecting to external serverless proxy)
EXPO_PUBLIC_API_URL=http://localhost:3000/api
