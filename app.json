{
  "expo": {
    "name": "EZCAT",
    "slug": "ezcat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ezcat",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-sqlite",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ninetyninevca.ezcat"
    },
    "android": {
      "package": "com.ninetyninevca.ezcat",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
